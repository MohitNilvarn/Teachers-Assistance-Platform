# TAP API environment variables.
# Copy to apps/api/.env and fill in values. Never commit the real .env.
# Source of truth: app/core/config.py

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# Supabase (auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# MongoDB Atlas (data + vector search)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=tap_database

# OpenRouter (content generation LLM)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# Groq (chatbot LLM)
GROQ_CHAT_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Deepgram (real-time lecture transcription)
DEEPGRAM_API_KEY=your-deepgram-api-key

# ------------------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------------------

# Redis cache (leave empty to disable)
REDIS_URL=

# Embeddings (run locally; the API key is not required)
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_COLLECTION=vector_embeddings

# File uploads (UPLOAD_DIR defaults to apps/api/uploads)
MAX_UPLOAD_SIZE_MB=50
# UPLOAD_DIR=

# Transcript summarization before content generation
TRANSCRIPT_SUMMARIZATION_ENABLED=true
SUMMARIZATION_TEMPERATURE=0.3
SUMMARIZATION_MAX_TOKENS=8000

# Advanced RAG pipeline
RAG_USE_HYDE=true
RAG_USE_QUERY_DECOMPOSITION=true
RAG_USE_RERANKING=true
RAG_USE_BM25=true
RAG_USE_CONTEXTUAL_COMPRESSION=true
RAG_USE_PARENT_CHILD=true
RAG_MAX_CONTEXT_TOKENS=8000
RAG_RERANK_TOP_K=10
RAG_MAX_SUB_QUERIES=4
