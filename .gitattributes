# Normalize line endings to LF in the repository regardless of contributor OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary

# Generated files: collapse in diffs
package-lock.json linguist-generated=true -diff
