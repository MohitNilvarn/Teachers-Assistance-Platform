# Repository-wide ignores (OS, editors, secrets).
# Language-specific rules live next to each app:
#   apps/api/.gitignore  (Python)
#   apps/web/.gitignore  (Node / Vite)

# ------------------------------------------------------------------------------
# Environment variables & secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
credentials.json
client_secret.json

# ------------------------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------------------------
# IDEs & editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iml
*.iws
*.ipr
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.*.sw[a-z]
*.un~

# ------------------------------------------------------------------------------
# Logs & temporary files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.orig
*.bak
