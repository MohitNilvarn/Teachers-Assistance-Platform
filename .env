# AI Content Generation Strategy
# Always summarize entire transcript using LLM before content generation
TRANSCRIPT_SUMMARIZATION_ENABLED=true
SUMMARIZATION_TEMPERATURE=0.3
SUMMARIZATION_MAX_TOKENS=2000

# Advanced RAG Configuration (NotebookLM-grade)
# Each feature can be toggled independently
RAG_USE_HYDE=true                         # HyDE: Hypothetical Document Embeddings
RAG_USE_QUERY_DECOMPOSITION=true          # Decompose complex queries into sub-queries
RAG_USE_RERANKING=true                    # Cross-encoder re-ranking for precision
RAG_USE_BM25=true                         # BM25 keyword search (hybrid with vectors)
RAG_USE_CONTEXTUAL_COMPRESSION=true       # Compress chunks to remove irrelevant sentences
RAG_USE_PARENT_CHILD=true                 # Parent-child chunk hierarchy (small-to-big)
RAG_MAX_CONTEXT_TOKENS=1500               # Max tokens for assembled context
RAG_RERANK_TOP_K=10                       # Max results after re-ranking
RAG_MAX_SUB_QUERIES=4                     # Max sub-queries from decomposition
